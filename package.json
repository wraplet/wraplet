{
  "name": "@wraplet/core",
  "version": "2.0.0-rc.2",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "author": "Łukasz Zaroda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wraplet/wraplet.git"
  },
  "files": [
    "dist"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "6 kB"
    }
  ],
  "scripts": {
    "setup": "pnpm install",
    "build": "webpack --mode production --config ./webpack.config.ts",
    "dev:build": "webpack --mode development --config ./webpack.config.ts",
    "dev:watch": "webpack --mode development --watch --config ./webpack.config.ts",
    "lint": "tsc --noemit && npx eslint './src/**/*.ts' './tests/**/*.ts'",
    "lint:fix": "npm exec eslint './src/**/*.ts' './tests/**/*.ts' --fix",
    "tests": "node --unhandled-rejections=throw ./node_modules/jest/bin/jest.js --coverage --detectOpenHandles",
    "tests:perf": "node --env-file=.env.perf --unhandled-rejections=throw --expose-gc ./node_modules/jest/bin/jest.js --config jest.config.ts --runInBand",
    "tests:all": "npm run tests && npm run tests:perf",
    "size": "size-limit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/webpack": "^5.28.5",
    "esbuild-register": "^3.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-cli": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.10.1",
    "prettier-eslint": "^17.1.3",
    "size-limit": "^14.3.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  }
}
